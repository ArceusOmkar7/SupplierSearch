# Copy to .env at repository root; supply your own local database password.
VERISOURCE_DATABASE_URL=postgresql+psycopg://verisource:CHANGE_ME@127.0.0.1:55432/verisource
VERISOURCE_POSTGRES_PORT=55432
# Used only by optional infra/compose.yaml; keep equal to the URL password.
VERISOURCE_POSTGRES_PASSWORD=CHANGE_ME
VERISOURCE_PROFILE=local-free
VERISOURCE_DATA_ROOT=.local/data
VERISOURCE_LEDGER_ROOT=.local/deletion-ledger
VERISOURCE_SNAPSHOT_ROOT=.local/snapshots
VERISOURCE_OLLAMA_URL=http://127.0.0.1:11434
VERISOURCE_OLLAMA_MODEL=qwen3.5:4b
# Operator must pin the actual installed full digest before inference.
VERISOURCE_OLLAMA_DIGEST=
VERISOURCE_PAID_SPEND_LIMIT=0
VERISOURCE_MODEL_CONCURRENCY=1
VERISOURCE_MODEL_CONTEXT_TOKENS=4096
# No telemetry, cloud fallback, automatic model download or external model key.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
